# ─────────────────────────────────────────────────────────────────────────────
# Footly — environment variables
# Copy this file to .env.local and fill in every value.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── App ───────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=Footly

# Base URL — no trailing slash
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebSocket server (odds feed broadcasts)
NEXT_PUBLIC_WS_URL=ws://localhost:3001


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Neon:     postgres://user:pass@ep-xxx.eu-west-2.aws.neon.tech/footly?sslmode=require
# Supabase: postgres://postgres:[pass]@db.[ref].supabase.co:5432/postgres

DATABASE_URL=postgres://user:password@localhost:5432/footly

# Connection pool size (PgBouncer or direct)
DATABASE_POOL_SIZE=10


# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash: rediss://default:[token]@[host].upstash.io:6379
# Local:   redis://localhost:6379

REDIS_URL=redis://localhost:6379


# ── Payments ──────────────────────────────────────────────────────────────────

# Paystack (primary PSP)
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Flutterwave (fallback PSP)
# Get keys from https://developer.flutterwave.com
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Which PSP to use by default: "paystack" | "flutterwave"
PSP_PRIMARY=paystack


# ── Odds feed ─────────────────────────────────────────────────────────────────

# Start with BetsAPI or The Odds API; swap to Sportradar when licensed.
# The provider adapter in odds-feed/provider.ts isolates this swap.

# BetsAPI (https://betsapi.com)
BETSAPI_TOKEN=your_betsapi_token

# The Odds API (https://the-odds-api.com) — good for early stage
ODDS_API_KEY=your_odds_api_key

# Sportradar (production — requires a commercial licence)
SPORTRADAR_API_KEY=your_sportradar_key
SPORTRADAR_BASE_URL=https://api.sportradar.us/soccer/production/v4/en

# Which provider is active: "betsapi" | "oddsapi" | "sportradar"
ODDS_PROVIDER=oddsapi


# ── Feature flags ─────────────────────────────────────────────────────────────

# KEEP THIS FALSE until your NLRC or LSLGA licence is granted.
# When false, the deposit and withdrawal flows are stubbed and
# no real money moves.
REAL_MONEY_ENABLED=false

# Enable virtual football rounds
VIRTUALS_ENABLED=true

# Enable the jackpot pool
JACKPOT_ENABLED=true


# ── Auth / sessions ───────────────────────────────────────────────────────────

# 32+ random characters — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# JWT expiry for API tokens (seconds)
JWT_EXPIRES_IN=86400


# ── Admin ─────────────────────────────────────────────────────────────────────

# Comma-separated list of user IDs that can access /admin
ADMIN_USER_IDS=1,2


# ── Observability ─────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Sentry DSN (optional — add when you go live)
SENTRY_DSN=


# ── BVN / identity verification ───────────────────────────────────────────────

# Flutterwave BVN verification (uses the same secret key above)
# or Smile Identity / Prembly for standalone KYC
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_PARTNER_ID=
