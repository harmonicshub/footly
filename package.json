{
  "name": "footly",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack sports betting platform for the Nigerian market",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql $DATABASE_URL -f schema.sql",
    "worker:settlement": "ts-node --project tsconfig.server.json odds-feed/settlement.ts",
    "worker:virtuals": "ts-node --project tsconfig.server.json games/virtuals.ts",
    "feed:stream": "ts-node --project tsconfig.server.json odds-feed/stream.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",

    "pg": "^8.12.0",
    "redis": "^4.7.0",

    "axios": "^1.7.3",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",

    "lucide-react": "^0.383.0",

    "zod": "^3.23.8",

    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",

    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19",

    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",

    "ts-node": "^10.9.2",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
